# Copy to .env. Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRAB_TOKEN=
CRAB_HOST=127.0.0.1
CRAB_PORT=8787
DEEPSEEK_API_KEY=
# For DeepSeek run: python3 ../tools/setup_deepseek.py
PI_AGENT_DIR=
PI_PROVIDER=
PI_MODEL=
# OpenAI-compatible audio API, or local service. Independent of Pi's model.
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=zh
TTS_URL=
TTS_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Alternatively JSON argv commands, no shell. STT prints transcript to stdout.
# STT_COMMAND=["python3","/absolute/path/transcribe.py","{input}"]
# TTS_COMMAND=["python3","/absolute/path/speak.py","{text}","{output}"]
# TTS command writes raw 16 kHz mono signed 16-bit little-endian PCM.
# TTS API PCM is 24 kHz, resampled by bridge.
CRAB_DEMO=false
CRAB_SAVE_RECORDINGS=false

# Unified ACP backend: pi (default), codex, claude.
# Each adapter needs its own provider credentials/login. Restart after changing.
CRAB_AGENT=pi
# Optional opaque model ID advertised by the selected ACP agent.
CRAB_ACP_MODEL=
# Optional trusted custom ACP stdio executable + arguments, JSON array, no shell.
# CRAB_ACP_COMMAND=["/absolute/path/to/agent","--acp"]
